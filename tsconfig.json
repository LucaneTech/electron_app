{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    
    //jsx support for React 17+
    "jsx": "react-jsx",

  },
  "include": ["src/**/*", "*.ts", "*.mts"]
}
